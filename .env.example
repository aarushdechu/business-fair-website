# Local server
PORT=3000
NODE_ENV=development
PUBLIC_URL=http://localhost:3000

# Orders database
DATABASE_URL=postgresql://username:password@localhost:5432/sketchy_orders

# Staff access
STAFF_PIN=choose-a-private-pin
ADMIN_EMAILS=

# Google sign-in
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
SESSION_SECRET=replace-with-a-long-random-secret-at-least-24-characters

# Optional ready-email notifications
RESEND_API_KEY=
EMAIL_FROM=
